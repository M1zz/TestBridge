{
  "name": "클립키보드 · 설정 하위 화면 HIG 검사",
  "platform": "ios",
  "bundleIdentifier": "com.Ysoup.TokenMemo",
  "launchArguments": [
    "-AppleLanguages",
    "(ko)",
    "-AppleLocale",
    "ko_KR",
    "-startedFresh.v444",
    "NO",
    "-firstShortcut.done.v1",
    "YES",
    "-tutorialChaptersDone.v1",
    "YES",
    "-keyboardStageOffered.v1",
    "YES",
    "-didYouKnow.optOut.v1",
    "YES",
    "-ghostSuggestionsOff_v1",
    "YES",
    "-defaultSamplesInserted_v1",
    "YES",
    "-demoSampleOfferResolved_v1",
    "YES",
    "-feedbackNudgeOptOutDate",
    "1762700000",
    "-snippetsTabStyle.v1",
    "list",
    "-blankStart.v1",
    "NO",
    "-blankStart.finished.v1",
    "YES",
    "-userState.showsAllFeatures.v1",
    "YES"
  ],
  "stopOnFailure": false,
  "steps": [
    {
      "action": "wait",
      "seconds": 3
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "tap",
      "target": {
        "type": "button",
        "label": "설정"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "scrollTo",
      "target": {
        "label": "키보드"
      },
      "direction": "up",
      "maxSwipes": 6
    },
    {
      "action": "tap",
      "target": {
        "label": "키보드"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "settings-keyboard"
    },
    {
      "action": "higAudit",
      "name": "settings-keyboard",
      "failOn": "error"
    },
    {
      "action": "tap",
      "target": {
        "id": "BackButton"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "scrollTo",
      "target": {
        "label": "단축어"
      },
      "direction": "up",
      "maxSwipes": 6
    },
    {
      "action": "tap",
      "target": {
        "label": "단축어"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "settings-shortcuts"
    },
    {
      "action": "higAudit",
      "name": "settings-shortcuts",
      "failOn": "error"
    },
    {
      "action": "tap",
      "target": {
        "id": "BackButton"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "scrollTo",
      "target": {
        "label": "화면과 표시"
      },
      "direction": "up",
      "maxSwipes": 6
    },
    {
      "action": "tap",
      "target": {
        "label": "화면과 표시"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "settings-appearance"
    },
    {
      "action": "higAudit",
      "name": "settings-appearance",
      "failOn": "error"
    },
    {
      "action": "tap",
      "target": {
        "id": "BackButton"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "scrollTo",
      "target": {
        "label": "내 데이터"
      },
      "direction": "up",
      "maxSwipes": 6
    },
    {
      "action": "tap",
      "target": {
        "label": "내 데이터"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "settings-my-data"
    },
    {
      "action": "higAudit",
      "name": "settings-my-data",
      "failOn": "error"
    },
    {
      "action": "tap",
      "target": {
        "id": "BackButton"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "scrollTo",
      "target": {
        "type": "staticText",
        "label": "무료로 쓰는 중"
      },
      "direction": "down",
      "maxSwipes": 6
    },
    {
      "action": "tap",
      "target": {
        "type": "staticText",
        "label": "무료로 쓰는 중"
      }
    },
    {
      "action": "wait",
      "seconds": 1
    },
    {
      "action": "screenshot",
      "name": "free-plan"
    },
    {
      "action": "higAudit",
      "name": "free-plan",
      "failOn": "error"
    },
    {
      "action": "tap",
      "target": {
        "type": "button",
        "labelContains": "Pro 보기"
      }
    },
    {
      "action": "wait",
      "seconds": 2
    },
    {
      "action": "screenshot",
      "name": "paywall"
    },
    {
      "action": "higAudit",
      "name": "paywall",
      "failOn": "error"
    }
  ]
}
